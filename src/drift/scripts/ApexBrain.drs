// The stalker's state machine is script-owned. TypeScript supplies deterministic world facts
// (pressure, turn and acoustic reach), while this module owns the escalation policy.
data ApexMind {
    mode: f32 = 0
}

fn advance(mind: mut ApexMind, pressure: f32, turn: f32, pulse: f32, heard: bool) {
    if mind.mode == 0 && (pressure >= 18 || (pulse >= 4 && turn >= 4)) {
        mind.mode = 1
    }

    if heard {
        mind.mode = 2
    }
}
